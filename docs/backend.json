
{
  "entities": {
    "User": {
      "title": "Utilisateur",
      "description": "Compte d'accès général au système.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "identifiant": { "type": "string" },
        "nom": { "type": "string" },
        "prenom": { "type": "string" },
        "sexe": { "type": "string", "enum": ["M", "F"] },
        "telephone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Directeur", "Enseignant", "Parent", "Eleve"] },
        "classeId": { "type": "string" },
        "matieresAttribuees": { "type": "array", "items": { "type": "string" } },
        "motDePasseHash": { "type": "string" },
        "premierAcces": { "type": "boolean" },
        "questionSecrete": { "type": "string" },
        "reponseSecrete": { "type": "string" },
        "statutCompte": { "type": "string", "enum": ["actif", "inactif", "suspendu"] },
        "derniereConnexion": { "type": "string", "format": "date-time" },
        "photoProfil": { "type": "string" },
        "dateCreation": { "type": "string", "format": "date-time" }
      },
      "required": ["identifiant", "nom", "role"]
    },
    "Eleve": {
      "title": "Élève",
      "description": "Dossier scolaire détaillé de l'élève.",
      "type": "object",
      "properties": {
        "eleveId": { "type": "string" },
        "matricule": { "type": "string" },
        "nom": { "type": "string" },
        "prenom": { "type": "string" },
        "dateNaissance": { "type": "string", "format": "date" },
        "lieuNaissance": { "type": "string" },
        "sexe": { "type": "string", "enum": ["M", "F"] },
        "classeId": { "type": "string" },
        "parentId": { "type": "string" },
        "adresse": { "type": "string" },
        "statut": { "type": "string" },
        "dateInscription": { "type": "string", "format": "date" },
        "photo": { "type": "string" }
      }
    },
    "Note": {
      "title": "Note",
      "type": "object",
      "properties": {
        "noteId": { "type": "string" },
        "eleveId": { "type": "string" },
        "classeId": { "type": "string" },
        "matiereId": { "type": "string" },
        "enseignantId": { "type": "string" },
        "trimestre": { "type": "string", "enum": ["T1", "T2", "T3"] },
        "interros": { "type": "array", "items": { "type": "number" } },
        "devoirs": { "type": "array", "items": { "type": "number" } },
        "moyenne": { "type": "number" },
        "coefficient": { "type": "number" },
        "dateAjout": { "type": "string", "format": "date-time" }
      }
    },
    "Bulletin": {
      "title": "Bulletin de Notes",
      "type": "object",
      "properties": {
        "bulletinId": { "type": "string" },
        "eleveId": { "type": "string" },
        "trimestre": { "type": "string" },
        "moyenneGenerale": { "type": "number" },
        "rang": { "type": "string" },
        "mention": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "qrCode": { "type": "string" }
      }
    },
    "Absence": {
      "title": "Absence",
      "type": "object",
      "properties": {
        "absenceId": { "type": "string" },
        "eleveId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "motif": { "type": "string" },
        "justification": { "type": "string" },
        "auteur": { "type": "string" }
      }
    },
    "Paiement": {
      "title": "Transaction de Paiement",
      "type": "object",
      "properties": {
        "paiementId": { "type": "string" },
        "eleveId": { "type": "string" },
        "typePaiement": { "type": "string" },
        "montant": { "type": "number" },
        "statut": { "type": "string" },
        "datePaiement": { "type": "string", "format": "date-time" },
        "resteAPayer": { "type": "number" },
        "anneeScolaire": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Comptes utilisateurs." },
    "/eleves/{eleveId}": { "schema": "Eleve", "description": "Dossiers élèves." },
    "/notes/{noteId}": { "schema": "Note", "description": "Notes individuelles." },
    "/bulletins/{bulletinId}": { "schema": "Bulletin", "description": "Archives des bulletins." },
    "/absences/{absenceId}": { "schema": "Absence", "description": "Suivi des présences." },
    "/paiements/{paiementId}": { "schema": "Paiement", "description": "Transactions financières." }
  }
}
